{
  "entities": {
    "ClubState": {
      "title": "ClubState",
      "description": "Global state document for the club",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "musicItems": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "updatedAt"]
    },
    "MusicItem": {
      "title": "MusicItem",
      "description": "Hymn or worship song entry stored inside ClubState.musicItems",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "composer": { "type": "string" },
        "category": { "type": "string", "enum": ["hinos_culto", "hino_chamada_pregador", "hino_marcha", "outros"] },
        "keySignature": { "type": "string" },
        "lyrics": { "type": "string" },
        "chordChartUrl": { "type": "string" },
        "audioUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "createdAt"]
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Push notification token registration for Android/mobile device",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "token": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "token", "updatedAt"]
    },
    "MemberSuggestion": {
      "title": "MemberSuggestion",
      "description": "Confidential suggestion sent from a club member directly to the director",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "memberManualNumber": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "category": { "type": "string" },
        "subject": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string" },
        "viewedByDirector": { "type": "boolean" },
        "viewedAt": { "type": "string" },
        "viewedByDirectorName": { "type": "string" },
        "responseContent": { "type": "string" },
        "respondedAt": { "type": "string" },
        "respondedByDirectorName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "memberId", "memberName", "category", "subject", "content", "status", "viewedByDirector", "createdAt", "updatedAt"]
    },
    "QuotaDebtWaiver": {
      "title": "QuotaDebtWaiver",
      "description": "Accounting-safe debt waiver / zeroing record for member quotas inside ClubState",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "amountWaivedInCents": { "type": "number" },
        "grossDueAtWaiverInCents": { "type": "number" },
        "paidAtWaiverInCents": { "type": "number" },
        "previousBalanceInCents": { "type": "number" },
        "cycleYear": { "type": "number" },
        "reason": { "type": "string" },
        "waivedByUserId": { "type": "string" },
        "waivedByName": { "type": "string" },
        "waivedByRole": { "type": "string" },
        "waivedAt": { "type": "string" },
        "isReversed": { "type": "boolean" },
        "reversalReason": { "type": "string" },
        "reversedAt": { "type": "string" },
        "reversedByUserId": { "type": "string" },
        "reversedByName": { "type": "string" }
      },
      "required": ["id", "memberId", "memberName", "amountWaivedInCents", "cycleYear", "reason", "waivedByUserId", "waivedByName", "waivedByRole", "waivedAt"]
    },
    "MemberEnrollmentRequest": {
      "title": "MemberEnrollmentRequest",
      "description": "Self-enrollment application submitted directly by a candidate/member for Secretary authorization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "protocolNumber": { "type": "string" },
        "manualNumber": { "type": "string" },
        "fullName": { "type": "string" },
        "birthDate": { "type": "string" },
        "gender": { "type": "string" },
        "identityCardNumber": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "category": { "type": "string" },
        "unitOrTeam": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "bloodType": { "type": "string" },
        "allergiesOrMedicalNotes": { "type": "string" },
        "joinedDate": { "type": "string" },
        "investitureDate": { "type": "string" },
        "professionalCourse": { "type": "string" },
        "status": { "type": "string" },
        "submittedAt": { "type": "string" },
        "reviewedByUserId": { "type": "string" },
        "reviewedByName": { "type": "string" },
        "reviewedByRole": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "decisionReason": { "type": "string" },
        "createdMemberId": { "type": "string" },
        "biDocumentFileName": { "type": "string" },
        "biDocumentBase64": { "type": "string" },
        "photoDocumentFileName": { "type": "string" },
        "photoDocumentBase64": { "type": "string" },
        "memberDeletedAt": { "type": "string" },
        "memberDeletedByUserId": { "type": "string" },
        "memberDeletedByName": { "type": "string" }
      },
      "required": ["id", "protocolNumber", "fullName", "birthDate", "identityCardNumber", "phone", "category", "status", "submittedAt"]
    },
    "Member": {
      "title": "Member",
      "description": "Official club member profile stored inside ClubState",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "manualNumber": { "type": "string" },
        "fullName": { "type": "string" },
        "birthDate": { "type": "string" },
        "identityCardNumber": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "biDocumentFileName": { "type": "string" },
        "biDocumentBase64": { "type": "string" },
        "photoDocumentFileName": { "type": "string" },
        "photoDocumentBase64": { "type": "string" },
        "attachedDocuments": { "type": "array" },
        "documentationStatus": { "type": "string" },
        "enrolledPeriodId": { "type": "string" },
        "lastReconfirmedPeriodId": { "type": "string" },
        "lastReconfirmedAt": { "type": "string" },
        "reconfirmationCount": { "type": "number" }
      },
      "required": ["id", "manualNumber", "fullName", "birthDate", "identityCardNumber"]
    }
  },
  "firestore": {
    "/club_data/{stateId}": {
      "schema": { "$ref": "#/entities/ClubState" },
      "description": "Synced global club state document across devices"
    },
    "/push_subscriptions/{userId}": {
      "schema": { "$ref": "#/entities/PushSubscription" },
      "description": "User push subscription tokens for background notifications"
    }
  }
}
